{
  "name": "dsh-resume",
  "version": "0.1.2",
  "description": "Markdown campus resume workbench: the agent edits resumes and CSS templates under jobhunt/, and the user previews and exports from the sidebar.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "DESIGN.zh.md",
    "LICENSE",
    "package.json",
    "AUTHORS.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "resume",
    "campus",
    "jobhunt",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L3n3L/dsh-resume.git"
  },
  "bugs": {
    "url": "https://github.com/L3n3L/dsh-resume/issues"
  },
  "homepage": "https://github.com/L3n3L/dsh-resume#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "author": "L3n3L"
}
